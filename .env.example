# ========== 基础配置 ==========
LOG_LEVEL=info
# stderr | file | sqlite | mysql | postgres
LOG_SINK=stderr
LOG_FILE=./logs/tickhub.log
REDIS_URL=redis://127.0.0.1:6379/0
PROXY_URL=
TDX_PATH=
FIELD_MAP_PATH=./field_map.toml
RUN_MODE=stdio
CACHE_ENV=prod

# ========== 数据源密钥 ==========
IWENCAI_API_KEY=
IWENCAI_BASE_URL=https://openapi.iwencai.com
TUSHARE_TOKEN=

# ========== 数据源开关（无密钥自动禁用） ==========
ENABLE_AKSHARE=true
ENABLE_MOOTDX=true
ENABLE_IWENCAI=true
ENABLE_TUSHARE=false
# 深交所 HTTPS 连接被重置时是否允许一次性回落到明文 HTTP（默认关闭，回退结果会在 meta 标注）
SZSE_ALLOW_HTTP=false

# ========== AI 文本清洗（默认关闭） ==========
# 推荐在管理台「运行配置 → 正文清洗」里开关、填端点和模型（写入 model_gateway.toml）。
# 这里的环境变量优先级最高：一旦设置就会覆盖管理台保存的值。
CRAWL4AI_ENABLE=false
# 以下四项留空表示交给管理台 / model_gateway.toml 决定
CRAWL4AI_BASE_URL=
CRAWL4AI_API_KEY=
CRAWL4AI_MODEL=
CRAWL4AI_PROMPT=提取正文，移除广告、导航、弹窗、无关链接，保留公告和研报全部业务内容，不要篡改原文信息

# ========== 离线增量爬虫队列 ==========
OFFLINE_CRAWLER_ENABLE=false
OFFLINE_CRAWLER_CRON=0 2 * * *
# 北向资金只在盘中/收盘后短时间可用，单独在收盘后 5 分钟快照
OFFLINE_CRAWLER_NORTHBOUND_CRON=5 15 * * 1-5
OFFLINE_CRAWLER_CONCURRENCY=2

# ========== 事件发布（FinanceCoffer 旁路，默认关闭） ==========
# 开启后每条新入库的公告/研报/风险/北向记录都会以事件形式写入 Redis Stream
# fc:stockdata:events；Redis 不可用时事件进入本地 outbox，恢复后自动补发，不影响抓取。
# 单独使用 db 1，避免与缓存（db 0）混用。
EVENT_PUBLISH_ENABLE=false
FC_EVENT_REDIS_URL=redis://127.0.0.1:6379/1

# ========== 代理池 ==========
PROXY_POOL_ENABLE=false
PROXY_POOL_LIST=
PROXY_POOL_CONFIG_PATH=logs/proxy_pool.json
PROXY_POOL_CHECK_TIMEOUT=10
PROXY_POOL_CHECK_INTERVAL=60

# ========== 日志落库 ==========
LOG_DB_HOST=127.0.0.1
LOG_DB_PORT=
LOG_DB_USER=
LOG_DB_PASSWORD=
LOG_DB_NAME=tickhub_log

# ========== 可视化 Admin Console ==========
ADMIN_ENABLE=false
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_AUTH_TOKEN=
ADMIN_READONLY=false
ADMIN_CORS_ORIGINS=
ADMIN_AUDIT_SINK=file
ADMIN_SENSITIVE_MASK=true

# ========== 多模型网关（可选） ==========
MODEL_GATEWAY_ENABLE=false
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=
